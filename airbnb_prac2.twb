      <aliases enabled='yes' />
      <column caption='ReviewPerformanceScore' datatype='integer' name='[Calculation_0414026298204160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='PRICE CATEGORY' datatype='string' name='[Calculation_0414026299944961]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; 300 then &quot;LUXURY&quot; ELSEIF [Price] &gt; 150 THEN &quot;STANDARD&quot; ELSE &quot;BUGDET&quot; END' />
      </column>
      <column caption='COUNT OF HOTELS' datatype='integer' name='[Calculation_0414026302853122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(Name)' />
      </column>
      <column caption='HOST STATUS' datatype='string' name='[Calculation_0414026306871299]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;TODAY() THEN &quot;ACTIVE HOST&quot; ELSE &quot;NEW HOST&quot; END' />
      </column>
      <column caption='REVIEW CATEGORY ' datatype='string' name='[Calculation_0414026307624964]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Number Of Reviews]&gt;=100 THEN  &quot;HIGHLY REVIEWED&quot; ELSE &quot;LESS REVIEWED&quot; END' />
      </column>
      <column caption='PRICE FILTER CATEGORY' datatype='string' name='[Calculation_0414026309242886]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;[Parameters].[Parameter 0414026308407301]THEN &quot;ABOVE LIMIT&quot; ELSE &quot;BELOW LIMIT&quot; END' />
      </column>
      <column caption='HOST SINCE NEW' datatype='date' name='[Calculation_0414026315026441]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IFNULL ([Host Since], DATE (&quot;01,01,2010&quot;))' />
      </column>
      <column caption='NEW HOST SINCE' datatype='date' name='[Calculation_0414026316115978]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL ([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='REVIEW SCORE RATING(BIN)' datatype='string' name='[Calculation_0414026318438411]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([Review Scores Rating (bin)]),&quot;NOT RATED&quot;)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='date' hidden='true' name='[Host Since]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
